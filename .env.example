# Copy to .env.local and fill in. Never commit real secrets.
DATABASE_URL=postgres://agenthub:agenthub@127.0.0.1:5440/agenthub
APP_URL=http://localhost:3000

# 32+ random characters: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Provider key encryption. Comma-separated "version:base64(32 bytes)".
# Generate one: echo "1:$(openssl rand -base64 32)"
# To rotate, append "2:<new key>"; the highest version encrypts, old versions still decrypt.
ENCRYPTION_KEYS=

# Outbound email. Leave empty in development: messages go to the email_outbox table
# and can be read at /dev/outbox. Required in production.
SMTP_URL=
MAIL_FROM=Agent Hub <no-reply@example.com>

# Trusted single-tenant mode. "true" lets provider connections reach localhost and
# private networks (Ollama, LAN servers). Keep "false" for any multi-tenant deployment.
ALLOW_PRIVATE_PROVIDER_HOSTS=false

# Set to "false" only for local development without email.
REQUIRE_EMAIL_VERIFICATION=true

RATE_LIMIT_CHAT_PER_MINUTE=20
MAX_CONCURRENT_RUNS_PER_WORKSPACE=3
MONTHLY_BUDGET_USD_PER_WORKSPACE=50

# Used for cost estimates when a connection has no pricing set (USD per million tokens).
PRICE_FALLBACK_INPUT_PER_MTOK=5
PRICE_FALLBACK_OUTPUT_PER_MTOK=25
